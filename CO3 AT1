Q3) CODING

#include <stdio.h>

int main() {
    int pageTable[20];
    int pages, pageNo, offset, frameNo, pageSize;

    printf("Enter number of pages: ");
    scanf("%d", &pages);

    printf("Enter page size: ");
    scanf("%d", &pageSize);

    printf("Enter frame number for each page:\n");

    for(int i = 0; i < pages; i++) {
        printf("Page %d: ", i);
        scanf("%d", &pageTable[i]);
    }

    printf("\nEnter Logical Address (Page Number Offset): ");
    scanf("%d%d", &pageNo, &offset);

    if(pageNo >= pages || offset >= pageSize) {
        printf("Invalid Logical Address.\n");
    } else {
        frameNo = pageTable[pageNo];

        printf("\nLogical Address");
        printf("\nPage Number : %d", pageNo);
        printf("\nOffset      : %d", offset);

        printf("\n\nPage Table Mapping");
        printf("\nPage %d ---> Frame %d", pageNo, frameNo);

        printf("\n\nPhysical Address = %d\n",
               frameNo * pageSize + offset);
    }

    return 0;
}

